{
  "name": "cloud-drop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cloud Drop - 轻量级云端文件中转站（Cloudflare Pages + R2 + 一方工具箱 OAuth 统一登录）",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p functions/tsconfig.json",
    "pages:dev": "wrangler pages dev --port 8788",
    "deploy": "npm run build && wrangler pages deploy",
    "preview": "npm run build && npm run pages:dev"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^4.8.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
